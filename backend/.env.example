# Copy to .env and adjust for your environment.
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Secrets — CHANGE THESE in production (use long random strings).
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Default admin credentials created on first seed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS: comma-separated list of allowed origins for the frontend dev server.
# Leave empty in production when the backend serves the built frontend.
CORS_ORIGINS=http://localhost:5173

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
